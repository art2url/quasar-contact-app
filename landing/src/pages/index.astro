                <defs>
                  <clipPath id="clip0_kg">
                    <rect width="512" height="512" fill="white"></rect>
                  </clipPath>
                </defs>
              </svg>
              <div class="step-content">
                <h4>Key Generation</h4>
                <p>
                  Your device generates a 2048-bit RSA key pair. The private key never leaves your
                  device.
                </p>
              </div>
            </div>

            <div class="tech-step">
              <span class="step-num">02</span>
              <svg
                class="step-icon"
                width="512"
                height="512"
