---
import ResponsiveImage from "../components/ResponsiveImage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Quasar Contact - Secure End-to-End Encrypted Chat"
  description="Experience military-grade security with Quasar Contact. End-to-end encrypted messaging with zero data logging. Start secure conversations today."
>
  <div class="lp-root">
    <!-- Decorative background glows -->
    <div class="lp-orbs" aria-hidden="true">
      <div class="lp-orb lp-orb-a"></div>
      <div class="lp-orb lp-orb-b"></div>
    </div>

    <div class="lp-wrap">
      <!-- ── HERO ── -->
      <section class="lp-hero" aria-labelledby="hero-title">
        <div class="lp-hero-text">
          <h1 id="hero-title" class="lp-h1 lp-in" style="--d:0.1s">
            Fast.<br />
            Secure.<br />
            <em class="lp-h1-em">Private.</em>
          </h1>

          <p class="lp-sub lp-in" style="--d:0.35s">
            Military-grade hybrid encryption for every message. Your private key is generated
            on-device — the server never sees it.
          </p>

          <div class="lp-ctas lp-in" style="--d:0.5s">
            <a
              href="/app"
              class="lp-btn-p"
              aria-label="Start chatting - Begin your private conversation"
            >
              Start Chatting
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
            </a>
            <a href="#how-it-works" class="lp-btn-g">
              How it works
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12l7 7 7-7"></path>
              </svg>
            </a>
          </div>
        </div>

        <div class="lp-hero-vis lp-in" style="--d:0.28s" aria-hidden="true">
          <div class="lp-chat">
            <div class="lp-ch-head">
              <img class="lp-ch-av" src="/assets/images/avatar-08.svg" alt="" />
              <div class="lp-ch-info">
                <span class="lp-ch-name">Alex</span>
                <span class="lp-ch-enc">
                  <svg
                    width="9"
                    height="9"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <rect width="18" height="11" x="3" y="11" rx="2"></rect>
                    <path d="M7 11V8a5 5 0 0 1 10 0v3"></path>
                  </svg>
                  End-to-end encrypted
                </span>
              </div>
            </div>
            <div class="lp-ch-body">
              <div class="lp-msg lp-msg-i"><span>Hey, sent you the files 📎</span></div>
              <div class="lp-msg lp-msg-o">
                <span>Got them, thanks!</span>
                <i class="lp-tt">✓✓</i>
              </div>
              <div class="lp-msg lp-msg-i"><span>Meet at 6?</span></div>
              <div class="lp-msg lp-msg-o">
                <span>See you there 👍</span>
                <i class="lp-tt">✓✓</i>
              </div>
              <div class="lp-dots"><span></span><span></span><span></span></div>
            </div>
            <div class="lp-ch-foot">
              <svg
                width="11"
                height="11"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect width="18" height="11" x="3" y="11" rx="2"></rect>
                <path d="M7 11V8a5 5 0 0 1 10 0v3"></path>
              </svg>
              Type a message...
            </div>
          </div>
          <span class="lp-chip lp-chip-a">RSA-2048</span>
          <span class="lp-chip lp-chip-b">AES-GCM</span>
          <span class="lp-chip lp-chip-c">Zero-Knowledge</span>
        </div>
      </section>

      <!-- ── STATS ── -->
      <div class="lp-stats lp-in" style="--d:0.65s" aria-label="Security specifications">
        <div class="lp-stat">
          <b>2048-bit</b><span>RSA Key Pair</span>
        </div>
        <div class="lp-stat">
          <b>AES-256</b><span>Message Cipher</span>
        </div>
        <div class="lp-stat">
          <b>Zero</b><span>Data Logged</span>
        </div>
        <div class="lp-stat">
          <b>&lt; 1s</b><span>Message Delivery</span>
        </div>
      </div>

      <!-- ── FEATURES ── -->
      <section class="lp-feats" aria-labelledby="lp-feats-title">
        <h2 id="lp-feats-title" class="sr-only">Quasar Security Features</h2>

        <a href="#how-it-works" class="lp-feat lp-in" style="--d:0.8s">
          <div class="lp-feat-ic">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
              <circle cx="12" cy="16" r="1"></circle>
              <path d="m7 11 0-3a5 5 0 0 1 10 0v3"></path>
            </svg>
          </div>
          <div class="lp-feat-tx">
            <h3>End-to-End Encryption</h3>
            <p>
              Military-grade RSA-OAEP + AES-GCM hybrid encryption. Your private key is generated
              locally and never leaves your device.
            </p>
          </div>
          <span class="lp-feat-ch">OAEP · GCM</span>
        </a>

        <a href="/faq" class="lp-feat lp-in" style="--d:0.95s">
          <div class="lp-feat-ic">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <polygon points="13,2 3,14 12,14 11,22 21,10 12,10"></polygon>
            </svg>
          </div>
          <div class="lp-feat-tx">
            <h3>Real-Time Messaging</h3>
            <p>
              JWT-authenticated WebSocket connections deliver messages instantly. Typing indicators
              and read receipts — all encrypted end-to-end.
            </p>
          </div>
          <span class="lp-feat-ch">Socket.IO · JWT</span>
        </a>

        <a href="/legal" class="lp-feat lp-in" style="--d:1.1s">
          <div class="lp-feat-ic">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"
              >
              </path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <div class="lp-feat-tx">
            <h3>Privacy First</h3>
            <p>
              No message logging, no data mining, no analytics on your conversations. Your messages
              are exclusively yours — always.
            </p>
          </div>
          <span class="lp-feat-ch">Local Key Vault</span>
        </a>
      </section>

      <!-- ── APP SHOWCASE ── -->
      <section class="app-showcase fade-in-up" data-delay="500" aria-labelledby="showcase-title">
        <div class="showcase-hd">
          <h2 id="showcase-title">See It in Action</h2>
          <p class="showcase-sub">Six screens. One interface. Real encrypted conversations.</p>
        </div>

        <div class="bc-frame">
          <div class="bc-bar">
            <div class="bc-dots">
              <span class="bc-dot bc-dot-r"></span>
              <span class="bc-dot bc-dot-y"></span>
              <span class="bc-dot bc-dot-g"></span>
            </div>
            <div class="bc-url">
              <svg
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              quasar.contact/app
            </div>
            <div class="bc-spacer"></div>
            <button class="carousel-btn carousel-btn-pause" aria-label="Pause/Play slideshow">
              <svg
                class="pause-icon"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="6" y="4" width="4" height="16"></rect>
                <rect x="14" y="4" width="4" height="16"></rect>
              </svg>
              <svg
                class="play-icon"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                style="display: none;"
              >
                <polygon points="5,3 19,12 5,21"></polygon>
              </svg>
            </button>
          </div>

          <div class="carousel-container">
            <div class="carousel-info-bar">
              <div class="carousel-tabs" id="carousel-tabs">
                <button class="carousel-tab active" data-slide="0">Messaging</button>
                <button class="carousel-tab" data-slide="1">Themes</button>
                <button class="carousel-tab" data-slide="2">Key Recovery</button>
                <button class="carousel-tab" data-slide="3">Account</button>
                <button class="carousel-tab" data-slide="4">Password</button>
                <button class="carousel-tab" data-slide="5">Privacy</button>
              </div>
              <div class="slide-info">
                <p class="slide-info-desc" id="slide-info-desc">
                  Send encrypted messages in real-time with delivery confirmation and read receipts.
                  Edit or delete messages seamlessly.
                </p>
              </div>
            </div>
            <div class="carousel-track" id="carousel-track">
              <div class="carousel-slide">
                <ResponsiveImage
                  src="slides/1_1270x510x1_notext.png"
                  alt="Chat interface showing encrypted messaging"
                  loading="lazy"
                />
              </div>
              <div class="carousel-slide">
                <ResponsiveImage
                  src="slides/2_1270x510x1_notext.png"
                  alt="Theme customization dark and light"
                  loading="lazy"
                />
              </div>
              <div class="carousel-slide">
                <ResponsiveImage
                  src="slides/3_1270x510x1_notext.png"
                  alt="Cross-device key recovery flow"
                  loading="lazy"
                />
              </div>
              <div class="carousel-slide">
                <ResponsiveImage
                  src="slides/4_1270x510x1_notext.png"
                  alt="Account authentication screen"
                  loading="lazy"
                />
              </div>
              <div class="carousel-slide">
                <ResponsiveImage
                  src="slides/5_1270x510x1_notext.png"
                  alt="Password recovery flow"
                  loading="lazy"
                />
              </div>
              <div class="carousel-slide">
                <ResponsiveImage
                  src="slides/6_1270x510x1_notext.png"
                  alt="Privacy controls and settings"
                  loading="lazy"
                />
              </div>
            </div>

            <button class="carousel-btn carousel-btn-prev" aria-label="Previous screenshot">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M15 18l-6-6 6-6"></path>
              </svg>
            </button>

            <button class="carousel-btn carousel-btn-next" aria-label="Next screenshot">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M9 18l6-6-6-6"></path>
              </svg>
            </button>
          </div>
        </div>
      </section>

      <!-- ── ENCRYPTION TECH (existing — add id for scroll anchor) ── -->
      <section
        id="how-it-works"
        class="encryption-tech fade-in-up"
        data-delay="600"
        aria-labelledby="encryption-title"
      >
        <div class="enc-hd">
          <h2 id="encryption-title">How Our Encryption Works</h2>
          <p class="enc-sub">
            Hybrid RSA-OAEP + AES-GCM pipeline — every message gets a unique key, wrapped in the
            recipient's public key. The server only ever sees ciphertext.
          </p>
        </div>

        <div class="enc-body">
          <div class="tech-steps">
            <div class="tech-step">
              <span class="step-num">01</span>
              <svg
                class="step-icon"
                width="512"
                height="512"
                viewBox="0 0 512 512"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
