<style>
  /* ── ROOT ── */
  .lp-root {
    flex: 1;
    min-height: calc(
      100vh - var(--beta-banner-height) - var(--header-height) - var(--footer-height)
    );
    margin-top: calc(var(--beta-banner-height) + var(--header-height));
    margin-bottom: var(--footer-height);
    transition: margin-top 0.3s ease;
    position: relative;
  }

  :global(body.beta-closed) .lp-root {
    min-height: calc(100vh - var(--header-height) - var(--footer-height));
    margin-top: var(--header-height);
  }

  /* ── BACKGROUND ORBS ── */
  .lp-orbs {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .lp-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
  }

  .lp-orb-a {
    width: 680px;
    height: 680px;
    background: radial-gradient(circle, rgba(195, 247, 58, 0.11) 0%, transparent 65%);
    top: -160px;
    right: 8%;
    animation: orb-a 14s ease-in-out infinite;
  }

  .lp-orb-b {
    width: 580px;
    height: 580px;
    background: radial-gradient(circle, rgba(104, 182, 132, 0.09) 0%, transparent 65%);
    bottom: 15%;
    left: -80px;
    animation: orb-b 19s ease-in-out infinite;
  }

  @keyframes orb-a {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-35px, 55px);
    }
  }
  @keyframes orb-b {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(45px, -35px);
    }
  }

  /* ── WRAPPER ── */
  .lp-wrap {
    max-width: 1200px;
    width: 100%;
    padding: 0 2rem 6rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 5rem;
    position: relative;
    z-index: 1;
  }

  /* ── ANIMATION UTILITY ── */
  .lp-in {
    opacity: 0;
    transform: translateY(22px);
    animation: lp-in 0.65s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0s) forwards;
  }

  @keyframes lp-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── HERO ── */
  .lp-hero {
    display: grid;
    grid-template-columns: 55% 45%;
    gap: 3rem;
    align-items: center;
    padding-top: 5rem;
  }

  .lp-hero-text {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Badge */
  .lp-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(195, 247, 58, 0.06);
    border: 1px solid rgba(195, 247, 58, 0.18);
    border-radius: 100px;
    padding: 5px 14px;
    width: fit-content;
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: rgba(195, 247, 58, 0.82);
    font-family: "Courier New", monospace;
  }

  .lp-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #c3f73a;
    flex-shrink: 0;
    animation: pulse 2.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(195, 247, 58, 0.55);
    }
    50% {
      box-shadow: 0 0 0 5px rgba(195, 247, 58, 0);
    }
  }

  /* Headline */
  .lp-h1 {
    font-size: clamp(3.5rem, 6vw, 6rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.025em;
    color: rgba(255, 255, 255, 0.93);
    margin: 0;
    font-style: normal;
  }

  .lp-h1-em {
    font-style: normal;
    display: block;
    background: linear-gradient(90deg, #c3f73a 0%, #95e06c 55%, #68b684 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Subtitle */
  .lp-sub {
    font-size: 1.1rem;
    line-height: 1.78;
    color: rgba(255, 255, 255, 0.52);
    font-weight: 400;
    max-width: 480px;
    margin: 0;
  }

  /* CTAs */
  .lp-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .lp-btn-p {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #c3f73a;
    color: #0c2524;
    text-decoration: none;
    padding: 0.875rem 2rem;
    border-radius: 50px;
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 22px rgba(195, 247, 58, 0.18);
    position: relative;
    overflow: hidden;
  }

  .lp-btn-p::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transform: translateX(-110%);
    transition: transform 0.45s ease;
  }

  .lp-btn-p:hover::after {
    transform: translateX(110%);
  }
  .lp-btn-p:hover {
    background: #d3f84e;
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(195, 247, 58, 0.28);
  }

  .lp-btn-p svg {
    transition: transform 0.3s ease;
  }
  .lp-btn-p:hover svg {
    transform: translateX(4px);
  }

  .lp-btn-g {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.58);
    text-decoration: none;
    padding: 0.875rem 1.5rem;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 500;
    border: 1px solid rgba(255, 255, 255, 0.11);
    transition: all 0.3s ease;
  }

  .lp-btn-g:hover {
    color: #c3f73a;
    border-color: rgba(195, 247, 58, 0.25);
    background: rgba(195, 247, 58, 0.04);
  }

  .lp-btn-g svg {
    transition: transform 0.3s ease;
  }
  .lp-btn-g:hover svg {
    transform: translateY(3px);
  }

  /* ── HERO VISUAL ── */
  .lp-hero-vis {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lp-chat {
    background: rgba(8, 18, 20, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 20px;
    overflow: hidden;
    width: 100%;
    max-width: 355px;
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    box-shadow:
      0 45px 90px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 0 0 1px rgba(195, 247, 58, 0.04) inset;
    animation: chat-float 7s ease-in-out infinite;
  }

  @keyframes chat-float {
    0%,
    100% {
      transform: translateY(0) rotate(0.25deg);
    }
    50% {
      transform: translateY(-14px) rotate(-0.25deg);
    }
  }

  .lp-ch-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.02);
  }

  .lp-ch-av {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    flex-shrink: 0;
    object-fit: cover;
  }

  .lp-ch-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .lp-ch-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.86);
  }

  .lp-ch-enc {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.65rem;
    color: #68b684;
    font-family: "Courier New", monospace;
  }

  .lp-ch-body {
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .lp-msg {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    max-width: 86%;
  }

  .lp-msg span {
    font-size: 0.78rem;
    line-height: 1.45;
    padding: 0.48rem 0.78rem;
    border-radius: 12px;
    display: block;
  }

  .lp-msg-i {
    align-self: flex-start;
  }
  .lp-msg-i span {
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.8);
    border-radius: 4px 12px 12px 12px;
  }

  .lp-msg-o {
    align-self: flex-end;
    margin-left: auto;
    flex-direction: row-reverse;
  }

  .lp-msg-o span {
    background: rgba(195, 247, 58, 0.1);
    color: #c3f73a;
    border: 1px solid rgba(195, 247, 58, 0.14);
    border-radius: 12px 4px 12px 12px;
  }

  .lp-tt {
    font-size: 0.6rem;
    color: #68b684;
    font-style: normal;
    padding-bottom: 2px;
    flex-shrink: 0;
  }

  .lp-dots {
    display: inline-flex;
    gap: 4px;
    padding: 0.45rem 0.72rem;
    background: rgba(255, 255, 255, 0.07);
    border-radius: 4px 12px 12px 12px;
    width: fit-content;
  }

  .lp-dots span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.32);
    animation: tdot 1.5s ease-in-out infinite;
  }

  .lp-dots span:nth-child(2) {
    animation-delay: 0.22s;
  }
  .lp-dots span:nth-child(3) {
    animation-delay: 0.44s;
  }

  @keyframes tdot {
    0%,
    60%,
    100% {
      opacity: 0.3;
      transform: scale(1);
    }
    30% {
      opacity: 1;
      transform: scale(1.38);
    }
  }

  .lp-ch-foot {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.58rem 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.055);
    background: rgba(195, 247, 58, 0.03);
    font-size: 0.63rem;
    color: rgba(195, 247, 58, 0.48);
    font-family: "Courier New", monospace;
    letter-spacing: 0.02em;
  }

  /* Floating cipher chips */
  .lp-chip {
    position: absolute;
    font-size: 0.6rem;
    font-family: "Courier New", monospace;
    letter-spacing: 0.07em;
    padding: 4px 10px;
    border-radius: 100px;
    border: 1px solid rgba(195, 247, 58, 0.17);
    color: rgba(195, 247, 58, 0.52);
    background: rgba(195, 247, 58, 0.04);
    pointer-events: none;
    z-index: 0;
  }

  .lp-chat {
    position: relative;
    z-index: 1;
  }

  .lp-chip-a {
    top: 3%;
    right: -5%;
    animation: chip-float 8s ease-in-out infinite;
    animation-delay: 0s;
  }
  .lp-chip-b {
    bottom: 11%;
    right: -2%;
    animation: chip-float 8s ease-in-out infinite;
    animation-delay: 2.8s;
  }
  .lp-chip-c {
    top: 32%;
    left: -10%;
    animation: chip-float 8s ease-in-out infinite;
    animation-delay: 5.2s;
  }

  @keyframes chip-float {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.52;
    }
    50% {
      transform: translateY(-9px);
      opacity: 0.88;
    }
  }

  /* ── STATS ── */
  .lp-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    overflow: hidden;
  }

  .lp-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    padding: 1.5rem 1rem;
    border-right: 1px solid rgba(255, 255, 255, 0.07);
    transition: background 0.2s ease;
    cursor: default;
  }

  .lp-stat:last-child {
    border-right: none;
  }

  .lp-stat b {
    font-size: 1rem;
    font-weight: 700;
    color: #c3f73a;
    font-family: "Courier New", monospace;
    letter-spacing: -0.01em;
  }

  .lp-stat span {
    font-size: 0.69rem;
    color: rgba(255, 255, 255, 0.38);
    font-weight: 400;
    text-align: center;
    line-height: 1.3;
  }

  /* ── FEATURES ── */
  .lp-feats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .lp-feat {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .lp-feat::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #c3f73a, transparent);
    transform: scaleX(0);
    transition: transform 0.4s ease;
  }

  .lp-feat:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(195, 247, 58, 0.14);
    transform: translateY(-5px);
    box-shadow:
      0 22px 44px rgba(0, 0, 0, 0.28),
      0 0 28px rgba(195, 247, 58, 0.04);
  }

  .lp-feat:hover::after {
    transform: scaleX(1);
  }

  .lp-feat-ic {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, rgba(195, 247, 58, 0.11), rgba(104, 182, 132, 0.08));
    border: 1px solid rgba(195, 247, 58, 0.12);
    border-radius: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #c3f73a;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .lp-feat:hover .lp-feat-ic {
    background: linear-gradient(135deg, rgba(195, 247, 58, 0.18), rgba(104, 182, 132, 0.13));
    transform: scale(1.07);
  }

  .lp-feat-tx h3 {
    color: rgba(255, 255, 255, 0.87);
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.45rem 0;
    transition: color 0.3s ease;
  }

  .lp-feat:hover .lp-feat-tx h3 {
    color: #c3f73a;
  }

  .lp-feat-tx p {
    color: rgba(255, 255, 255, 0.46);
    font-size: 0.845rem;
    line-height: 1.65;
    margin: 0;
    font-weight: 400;
  }

  .lp-feat-ch {
    display: inline-block;
    font-size: 0.6rem;
    font-family: "Courier New", monospace;
    letter-spacing: 0.06em;
    color: rgba(195, 247, 58, 0.52);
    background: rgba(195, 247, 58, 0.05);
    border: 1px solid rgba(195, 247, 58, 0.1);
    border-radius: 100px;
    padding: 3px 10px;
    margin-top: auto;
    width: fit-content;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 1100px) {
    .lp-hero {
      gap: 2.5rem;
    }
    .lp-h1 {
      font-size: clamp(3rem, 5.5vw, 5rem);
    }
  }

  @media (max-width: 900px) {
    .lp-hero {
      grid-template-columns: 1fr;
      padding-top: 3rem;
      gap: 2.5rem;
    }
    .lp-hero-vis {
      order: -1;
    }
    .lp-chat {
      max-width: 100%;
    }

    .lp-feats {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .lp-stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .lp-stat:nth-child(2) {
      border-right: none;
    }
    .lp-stat:nth-child(1),
    .lp-stat:nth-child(2) {
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }
  }

  @media (max-width: 640px) {
    .lp-wrap {
      padding: 0 1rem 4rem;
      gap: 3.5rem;
    }
    .lp-hero {
      padding-top: 2rem;
    }
    .lp-hero-vis {
      display: none;
    }
    .lp-h1 {
      font-size: clamp(2.8rem, 10vw, 3.8rem);
    }
    .lp-sub {
      font-size: 1rem;
    }
    .lp-ctas {
      flex-direction: column;
      align-items: stretch;
    }
    .lp-btn-p,
    .lp-btn-g {
      justify-content: center;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .lp-stats {
      grid-template-columns: 1fr 1fr;
    }
    .lp-stat {
      padding: 1.1rem 0.75rem;
    }
    .lp-stat b {
      font-size: 0.88rem;
    }
    .lp-stat:nth-child(2) {
      border-right: none;
    }
    .lp-stat:nth-child(3) {
      border-right: 1px solid rgba(255, 255, 255, 0.07);
      border-bottom: none;
    }
    .lp-stat:nth-child(1),
    .lp-stat:nth-child(2) {
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-in {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .lp-orb-a,
    .lp-orb-b,
    .lp-chat,
    .lp-chip,
    .lp-pulse,
    .lp-dots span {
      animation: none;
    }
  }

  /* ── LP-FEAT AS LINKS ── */
  .lp-feat {
    text-decoration: none;
    cursor: pointer;
  }

  /* ── ENCRYPTION SECTION ── */
  :global(.enc-body) {
    border-color: rgba(255, 255, 255, 0.07) !important;
    background: rgba(255, 255, 255, 0.015) !important;
  }

  .enc-hd {
    margin-bottom: 2rem;
    text-align: center;
  }

  .enc-hd h2 {
    background: none;
    -webkit-text-fill-color: rgba(255, 255, 255, 0.93);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    margin: 0 0 0.65rem;
    line-height: 1.1;
    text-align: center;
  }

  .enc-sub {
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.93rem;
    line-height: 1.68;
    margin: 0;
    font-weight: 300;
  }

  .step-num {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-family: "Courier New", monospace;
    font-size: 0.7rem;
    font-weight: 400;
    color: rgba(195, 247, 58, 0.55);
    letter-spacing: 0.1em;
  }

  :global(.tech-steps) {
    grid-template-columns: repeat(4, 1fr) !important;
    gap: 0.85rem !important;
    margin-bottom: 1.5rem !important;
  }

  :global(.tech-step) {
    flex-direction: column !important;
    align-items: flex-start !important;
    background: rgba(255, 255, 255, 0.025) !important;
    border-color: rgba(255, 255, 255, 0.07) !important;
    border-radius: 14px !important;
    position: relative !important;
    gap: 0.65rem !important;
  }

  :global(.step-icon) {
    width: 44px !important;
    height: 44px !important;
  }

  :global(.tech-step h4) {
    color: rgba(255, 255, 255, 0.88) !important;
    font-weight: 600 !important;
    letter-spacing: -0.01em !important;
    font-size: 0.92rem !important;
  }

  :global(.tech-step p) {
    font-size: 0.82rem !important;
    line-height: 1.55 !important;
    font-weight: 300 !important;
    color: rgba(255, 255, 255, 0.38) !important;
  }

  :global(.tech-specs) {
    gap: 0.6rem !important;
  }

  :global(.spec-item) {
    background: none !important;
    border: 1px solid rgba(255, 255, 255, 0.07) !important;
    border-radius: 10px !important;
    padding: 0.85rem 1rem !important;
  }

  :global(.spec-item strong) {
    color: #c3f73a !important;
    font-family: "Courier New", monospace !important;
    font-size: 0.75rem !important;
    font-weight: 400 !important;
    letter-spacing: 0.07em !important;
    text-transform: uppercase !important;
  }

  :global(.spec-item span) {
    color: rgba(255, 255, 255, 0.4) !important;
    font-size: 0.78rem !important;
    font-weight: 300 !important;
    line-height: 1.4 !important;
  }

  /* ── SHOWCASE SECTION ── */
  :global(.app-showcase) {
    text-align: left !important;
  }

  :global(.app-showcase > h2) {
    display: none !important;
  }

  .showcase-hd {
    margin-bottom: 2rem;
    text-align: center;
  }

  .showcase-hd h2 {
    background: none;
    -webkit-text-fill-color: rgba(255, 255, 255, 0.93);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    margin: 0 0 0.65rem;
    line-height: 1.1;
    text-align: center;
  }

  .showcase-sub {
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.93rem;
    line-height: 1.68;
    margin: 0;
    font-weight: 300;
  }

  /* browser chrome */
  .bc-frame {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 1.25rem;
  }

  .bc-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.85rem;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    position: relative;
  }

  .bc-dots {
    display: flex;
    gap: 0.38rem;
    flex-shrink: 0;
  }

  .bc-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .bc-dot-r {
    background: #ff5f57;
  }
  .bc-dot-y {
    background: #febc2e;
  }
  .bc-dot-g {
    background: #28c840;
  }

  .bc-url {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 5px;
    padding: 0.22rem 0.7rem;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.38);
    font-family: "Courier New", monospace;
    white-space: nowrap;
  }

  .bc-spacer {
    flex: 1;
  }

  .bc-url svg {
    color: rgba(195, 247, 58, 0.55);
    flex-shrink: 0;
  }

  :global(.bc-frame .carousel-container) {
    border-radius: 0 !important;
    margin: 0 !important;
  }

  :global(.bc-frame .carousel-slide img) {
    border-radius: 0 !important;
    border: none !important;
  }

  :global(.bc-bar .carousel-btn-pause) {
    position: static !important;
    transform: none !important;
    flex-shrink: 0;
    width: 24px !important;
    height: 24px !important;
    padding: 0 !important;
    background: none !important;
    border: none !important;
    opacity: 0.4;
  }

  :global(.bc-bar .carousel-btn-pause:hover) {
    opacity: 1;
    background: none !important;
  }

  /* info bar inside browser frame */
  .carousel-info-bar {
    padding: 2.5rem 1.25rem 0.9rem;
    text-align: center;
  }

  /* slide info */
  .slide-info {
    min-height: unset;
    padding: 0;
    border-bottom: none;
    margin-bottom: 0;
    flex: 1;
  }

  .slide-info-desc {
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.86rem;
    line-height: 1.65;
    margin: 0 0 1.25rem;
    font-weight: 300;
  }

  /* feature tabs */
  .carousel-tabs {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .carousel-tab {
    padding: 0.38rem 0.85rem;
